# Copy to .env and fill in. Never commit .env.
# Get these from your Appwrite console: Project Settings (endpoint/project id)
# and Project Settings > API Keys (create a key with scopes: users.write,
# databases.write, documents.write, files.write — needed only by setup/seed
# scripts, which run as an admin, never shipped to the browser).

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key

APPWRITE_DATABASE_ID=secure_login_db
APPWRITE_FILES_COLLECTION_ID=files
APPWRITE_BUCKET_ID=user-files
