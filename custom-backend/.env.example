# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=secure_login_dev
PGUSER=postgres
PGPASSWORD=change_me

# CORS: origin the web client is served from. "*" is fine for local testing
# since we use bearer tokens (no cookies), but set this to a real origin in
# any deployed environment.
CORS_ORIGIN=*

# bcrypt cost factor (10-12 is a reasonable range for interactive logins)
BCRYPT_SALT_ROUNDS=12

# Session token lifetime, in hours
SESSION_TTL_HOURS=12

# Login lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=1
